digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.32",
         ranksep="0.68", splines=polyline, outputorder=edgesfirst,
         fontname="NanumBarunGothic", fontsize=20, label="MIRIS: 교통 영상·YOLOv3 JSON에서 PostgreSQL 부분색인까지
외부 14G -&gt; query 파일 4.0M + PostgreSQL 서비스 상태 | Warsaw/Shibuya 12개 고정 카메라",
         labelloc=t, labeljust=l];
  node [fontname="NanumBarunGothic", color="#526476"];
  edge [fontname="NanumBarunGothic", fontsize=9, color="#526476",
        penwidth=1.15, arrowsize=0.72];

  raw [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="330" BGCOLOR="#E8F3FA" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>1. 외부 원본 파일</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>미디어</B><BR ALIGN="LEFT"/>warsaw/*.mp4 + shibuya/*.mp4<BR ALIGN="LEFT"/>12개 고정 카메라 영상<BR ALIGN="LEFT"/>beach/uav 트랙은 현재 실험에서 제외</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>메타/검출</B><BR ALIGN="LEFT"/>*-detections.json / *-baseline.json<BR ALIGN="LEFT"/>YOLOv3 검출·track 결과<BR ALIGN="LEFT"/>전 프레임 사람 GT가 아님</FONT></TD></TR></TABLE>>];
  transform [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="330" BGCOLOR="#EAF6EC" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>2. 연구 처리</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>① 프레임 임베딩</B><BR ALIGN="LEFT"/>6-frame stride, video당 최대 5,200<BR ALIGN="LEFT"/>총 60,019 frames<BR ALIGN="LEFT"/>CLIP ViT-B/32 -&gt; 512차원</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>①/③ predicate</B><BR ALIGN="LEFT"/>scene=Warsaw/Shibuya<BR ALIGN="LEFT"/>video=카메라-세션 파일명<BR ALIGN="LEFT"/>nobj=YOLOv3 검출 객체수<BR ALIGN="LEFT"/>tseg=video 상대 위치를 0..23으로 양자화</FONT></TD></TR></TABLE>>];
  stored [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="360" BGCOLOR="#F5F7FA" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>3. 현재 디스크/DB 산출물</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>파일</B><BR ALIGN="LEFT"/>miris_queries2.npy: 1,000 x 512 float32<BR ALIGN="LEFT"/>hold-out query vector만 portable 파일로 보존</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>PostgreSQL + pgvector</B><BR ALIGN="LEFT"/>miris_frames2: 59,019 rows (~162.1MiB)<BR ALIGN="LEFT"/>vector(512), scene, video, nobj, tseg<BR ALIGN="LEFT"/>volume: Datasets/services/postgres_pgvector</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>보존 상태</B><BR ALIGN="LEFT"/>추출 JPG는 저장하지 않음<BR ALIGN="LEFT"/>구형 miris_frames도 59,019 rows<BR ALIGN="LEFT"/>구형 hour 열은 실제 시계 시간이 아니므로 해석 금지</FONT></TD></TR></TABLE>>];
  use [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="330" BGCOLOR="#FFF3D6" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>4. 논문에서 실제 사용</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>filtered-ANN</B><BR ALIGN="LEFT"/>scene/video/nobj 조건 검색<BR ALIGN="LEFT"/>1,000 hold-out query의 exact GT 비교</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>DB 설계</B><BR ALIGN="LEFT"/>부분색인·hot/cold 정책 외적 타당성<BR ALIGN="LEFT"/>캡션/semantic qrels 검색에는 사용하지 않음</FONT></TD></TR></TABLE>>];
  raw -> transform [xlabel="입력"];
  transform -> stored [xlabel="materialize"];
  stored -> use [xlabel="평가 입력"];
  { rank=same; raw; transform; }
  { rank=same; stored; use; }
  raw -> stored [style=invis, weight=40];
  transform -> use [style=invis, weight=40];
  warning [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#C63C36" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="520" BGCOLOR="#FFF1F0" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>해석 시 주의</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>논문 표기 원칙</B><BR ALIGN="LEFT"/>nobj는 검출기 출력 수이며 사람 정답 객체수가 아니다.<BR ALIGN="LEFT"/>벡터 본체의 portable dump/parquet가 없어 장기 보존이 DB volume에 의존한다.</FONT></TD></TR></TABLE>>];
  stored -> warning [style=dashed, arrowhead=none, color="#C63C36", constraint=false];
  legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#A7B3C0" CELLSPACING="0" CELLPADDING="6">
      <TR>
        <TD BGCOLOR="#E8F3FA">외부 원본/원 배포</TD>
        <TD BGCOLOR="#EAF6EC">① 추출·파싱·임베딩</TD>
        <TD BGCOLOR="#FFF1C7">② 본 연구 AI 생성</TD>
        <TD BGCOLOR="#FFE5D6">③ 합성·proxy</TD>
        <TD BGCOLOR="#F5F7FA">현재 저장 파일/DB</TD>
        <TD BGCOLOR="#FFF3D6">논문 실험 입력</TD>
      </TR>
    </TABLE>>];
  use -> warning [style=invis, weight=30];
  warning -> legend [style=invis, weight=30];
  }
