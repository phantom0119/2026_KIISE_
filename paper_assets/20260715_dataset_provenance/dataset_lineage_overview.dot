digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.32",
         ranksep="0.68", splines=ortho, outputorder=edgesfirst,
         fontname="NanumBarunGothic", fontsize=20, label="본 연구 데이터셋 전체 계보: 파일 형식·저장 산출물·실험 역할
2026-07-15 디스크 실측 | Datasets -&gt; /hdd2/KIISE_datasociety/Datasets | 상세도 8장 별도 제공",
         labelloc=t, labeljust=l];
  node [fontname="NanumBarunGothic", color="#526476"];
  edge [fontname="NanumBarunGothic", fontsize=9, color="#526476",
        penwidth=1.15, arrowsize=0.72];

  d522 [shape=plain, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" WIDTH="355" BGCOLOR="#243B53" ALIGN="LEFT" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="15"><B>AI Hub 522 교차로</B></FONT><BR ALIGN="LEFT"/><FONT COLOR="#D9E2EC" POINT-SIZE="10">헤드라인: 검색 + 색인 + 답변</FONT></TD></TR><TR><TD WIDTH="76" BGCOLOR="#E8F3FA"><B>원본</B></TD><TD ALIGN="LEFT" CELLPADDING="7">198G archive<BR ALIGN="LEFT"/>JPG 프레임 + 센서 CSV + CVAT XML</TD></TR><TR><TD BGCOLOR="#F5F7FA"><B>저장</B></TD><TD ALIGN="LEFT" CELLPADDING="7">processed 142G<BR ALIGN="LEFT"/>AI 캡션 3,000 + BGE 1,024d<BR ALIGN="LEFT"/>전체 프레임 143,830 + CLIP 512d</TD></TR><TR><TD BGCOLOR="#FFF3D6"><B>사용</B></TD><TD ALIGN="LEFT" CELLPADDING="7">tri-source 검색 85질의<BR ALIGN="LEFT"/>filtered-ANN/저장, 지각 한계 파일럿</TD></TR></TABLE>>];
  dsin [shape=plain, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" WIDTH="355" BGCOLOR="#243B53" ALIGN="LEFT" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="15"><B>AI Hub 시내도로</B></FONT><BR ALIGN="LEFT"/><FONT COLOR="#D9E2EC" POINT-SIZE="10">실 프레임 색인 + 합성 규모 확장</FONT></TD></TR><TR><TD WIDTH="76" BGCOLOR="#E8F3FA"><B>원본</B></TD><TD ALIGN="LEFT" CELLPADDING="7">320G JPG ZIP<BR ALIGN="LEFT"/>위치·카메라·파일시각 포함 CCTV 프레임</TD></TR><TR><TD BGCOLOR="#F5F7FA"><B>저장</B></TD><TD ALIGN="LEFT" CELLPADDING="7">real 132,521 x 512 CLIP<BR ALIGN="LEFT"/>frame_index.parquet<BR ALIGN="LEFT"/>synthetic 1,000,000 x 512</TD></TR><TR><TD BGCOLOR="#FFF3D6"><B>사용</B></TD><TD ALIGN="LEFT" CELLPADDING="7">실 predicate filtered-ANN<BR ALIGN="LEFT"/>FAISS/pgvector 규모·부분색인</TD></TR></TABLE>>];
  dmeva [shape=plain, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" WIDTH="355" BGCOLOR="#243B53" ALIGN="LEFT" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="15"><B>MEVA</B></FONT><BR ALIGN="LEFT"/><FONT COLOR="#D9E2EC" POINT-SIZE="10">검색 외적 타당성 + 저장 단위</FONT></TD></TR><TR><TD WIDTH="76" BGCOLOR="#E8F3FA"><B>원본</B></TD><TD ALIGN="LEFT" CELLPADDING="7">로컬 KPF/DIVA JSON 7.6G<BR ALIGN="LEFT"/>S3 AVI는 일시 다운로드 후 삭제</TD></TR><TR><TD BGCOLOR="#F5F7FA"><B>저장</B></TD><TD ALIGN="LEFT" CELLPADDING="7">중간프레임 JPG 985<BR ALIGN="LEFT"/>AI 캡션 985 + BGE/CLIP<BR ALIGN="LEFT"/>canonical 193질의</TD></TR><TR><TD BGCOLOR="#FFF3D6"><B>사용</B></TD><TD ALIGN="LEFT" CELLPADDING="7">활동 검색 외적 타당성<BR ALIGN="LEFT"/>프레임/벡터 저장 단위 비교</TD></TR></TABLE>>];
  dmiris [shape=plain, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" WIDTH="355" BGCOLOR="#243B53" ALIGN="LEFT" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="15"><B>MIRIS</B></FONT><BR ALIGN="LEFT"/><FONT COLOR="#D9E2EC" POINT-SIZE="10">부분색인·hot/cold 외적 타당성</FONT></TD></TR><TR><TD WIDTH="76" BGCOLOR="#E8F3FA"><B>원본</B></TD><TD ALIGN="LEFT" CELLPADDING="7">14G MP4 + YOLOv3 JSON<BR ALIGN="LEFT"/>Warsaw/Shibuya 12개 고정 카메라</TD></TR><TR><TD BGCOLOR="#F5F7FA"><B>저장</B></TD><TD ALIGN="LEFT" CELLPADDING="7">hold-out NPY 1,000 x 512<BR ALIGN="LEFT"/>PostgreSQL 59,019행<BR ALIGN="LEFT"/>scene/video/nobj/tseg</TD></TR><TR><TD BGCOLOR="#FFF3D6"><B>사용</B></TD><TD ALIGN="LEFT" CELLPADDING="7">공간·내용 predicate filtered-ANN<BR ALIGN="LEFT"/>부분색인 및 hot/cold 정책</TD></TR></TABLE>>];
  dvru [shape=plain, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" WIDTH="355" BGCOLOR="#243B53" ALIGN="LEFT" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="15"><B>VRU-Accident</B></FONT><BR ALIGN="LEFT"/><FONT COLOR="#D9E2EC" POINT-SIZE="10">순환성 수리 대조 + 답변 앵커</FONT></TD></TR><TR><TD WIDTH="76" BGCOLOR="#E8F3FA"><B>원본</B></TD><TD ALIGN="LEFT" CELLPADDING="7">MP4 1,000 (3.0G)<BR ALIGN="LEFT"/>외부 HF dense caption/VQA 5.8G</TD></TR><TR><TD BGCOLOR="#F5F7FA"><B>저장</B></TD><TD ALIGN="LEFT" CELLPADDING="7">수리판 6.1M<BR ALIGN="LEFT"/>외부 dense caption 1,000문서<BR ALIGN="LEFT"/>canonical 85질의 + BGE</TD></TR><TR><TD BGCOLOR="#FFF3D6"><B>사용</B></TD><TD ALIGN="LEFT" CELLPADDING="7">수리 전후 순환 붕괴<BR ALIGN="LEFT"/>고정 LLM 증거 사다리</TD></TR></TABLE>>];
  dint [shape=plain, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" WIDTH="355" BGCOLOR="#243B53" ALIGN="LEFT" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="15"><B>AI Hub 지능형 관제</B></FONT><BR ALIGN="LEFT"/><FONT COLOR="#D9E2EC" POINT-SIZE="10">국내 소형 수리 대조</FONT></TD></TR><TR><TD WIDTH="76" BGCOLOR="#E8F3FA"><B>원본</B></TD><TD ALIGN="LEFT" CELLPADDING="7">staging MP4 269 + JSON 269<BR ALIGN="LEFT"/>13G, media-label 누락 0</TD></TR><TR><TD BGCOLOR="#F5F7FA"><B>저장</B></TD><TD ALIGN="LEFT" CELLPADDING="7">외부 event_caption 269문서<BR ALIGN="LEFT"/>수리판 1.5M<BR ALIGN="LEFT"/>canonical 18질의 + BGE</TD></TR><TR><TD BGCOLOR="#FFF3D6"><B>사용</B></TD><TD ALIGN="LEFT" CELLPADDING="7">단일 JSON 생산자 한계<BR ALIGN="LEFT"/>수리 후 국내 CCTV 이식성</TD></TR></TABLE>>];
  duca [shape=plain, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" WIDTH="355" BGCOLOR="#243B53" ALIGN="LEFT" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="15"><B>UCA/UCF-Crime</B></FONT><BR ALIGN="LEFT"/><FONT COLOR="#D9E2EC" POINT-SIZE="10">2.5채널 검색 외적 타당성</FONT></TD></TR><TR><TD WIDTH="76" BGCOLOR="#E8F3FA"><B>원본</B></TD><TD ALIGN="LEFT" CELLPADDING="7">raw MP4 1,950 / UCA 주석 대상 1,854<BR ALIGN="LEFT"/>문장/구간 23,542, 로컬 194G, 총 110.7시간</TD></TR><TR><TD BGCOLOR="#F5F7FA"><B>저장</B></TD><TD ALIGN="LEFT" CELLPADDING="7">중간프레임 JPG + AI 캡션 6,432<BR ALIGN="LEFT"/>processed 176M<BR ALIGN="LEFT"/>canonical 135질의 + BGE</TD></TR><TR><TD BGCOLOR="#FFF3D6"><B>사용</B></TD><TD ALIGN="LEFT" CELLPADDING="7">사건 구간 기반 검색<BR ALIGN="LEFT"/>센서 없는 2.5채널 대조</TD></TR></TABLE>>];
  dmulti [shape=plain, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" WIDTH="355" BGCOLOR="#243B53" ALIGN="LEFT" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="15"><B>AI Hub 다각도 CCTV</B></FONT><BR ALIGN="LEFT"/><FONT COLOR="#D9E2EC" POINT-SIZE="10">다중 시점 증거 선택·답변</FONT></TD></TR><TR><TD WIDTH="76" BGCOLOR="#E8F3FA"><B>원본</B></TD><TD ALIGN="LEFT" CELLPADDING="7">483G ZIP<BR ALIGN="LEFT"/>사건 4,500 + MP4 9,000(c1/c2) + JSON</TD></TR><TR><TD BGCOLOR="#F5F7FA"><B>저장</B></TD><TD ALIGN="LEFT" CELLPADDING="7">canonical 426M<BR ALIGN="LEFT"/>bbox 비대칭 400사건<BR ALIGN="LEFT"/>evidence JPG 2,400 + VLM 답변</TD></TR><TR><TD BGCOLOR="#FFF3D6"><B>사용</B></TD><TD ALIGN="LEFT" CELLPADDING="7">worse/better/both 짝지은 답변<BR ALIGN="LEFT"/>검색 문서가 아닌 평가 결과</TD></TR></TABLE>>];
  { rank=same; d522; dsin; dmeva; dmiris; }
  { rank=same; dvru; dint; duca; dmulti; }
  d522 -> dsin -> dmeva -> dmiris [style=invis, weight=100];
  dvru -> dint -> duca -> dmulti [style=invis, weight=100];
  d522 -> dvru [style=invis, weight=100];
  legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#A7B3C0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#E8F3FA">원본: 외부 배포 파일</TD><TD BGCOLOR="#F5F7FA">저장: 현재 materialized 파일/DB</TD><TD BGCOLOR="#FFF3D6">사용: 논문 평가 입력</TD><TD>크기는 du -sh, 행·shape는 parquet/NPY/DB 실측</TD></TR></TABLE>>];
  dmulti -> legend [style=invis, weight=50];
  }
