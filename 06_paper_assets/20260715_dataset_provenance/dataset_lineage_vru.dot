digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.32",
         ranksep="0.68", splines=polyline, outputorder=edgesfirst,
         fontname="NanumBarunGothic", fontsize=20, label="VRU-Accident: 외부 영상·dense caption에서 비순환 수리판까지
영상 3.0G + 외부 HF 표 5.8G -&gt; 현재 수리판 6.1M | 1,000 clips",
         labelloc=t, labeljust=l];
  node [fontname="NanumBarunGothic", color="#526476"];
  edge [fontname="NanumBarunGothic", fontsize=9, color="#526476",
        penwidth=1.15, arrowsize=0.72];

  raw [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="330" BGCOLOR="#E8F3FA" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>1. 외부 원본 파일</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>영상</B><BR ALIGN="LEFT"/>raw/VRU-Accident/VRU_videos/**/*.mp4<BR ALIGN="LEFT"/>CAP_DATA, DADA_2000, DoTA, MANUAL_DATA<BR ALIGN="LEFT"/>총 1,000 accident clips</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>외부 문서/라벨</B><BR ALIGN="LEFT"/>HF *.parquet<BR ALIGN="LEFT"/>dense caption 1,000 + VQA 6,000<BR ALIGN="LEFT"/>본 연구 Qwen 생성물이 아님</FONT></TD></TR></TABLE>>];
  transform [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="330" BGCOLOR="#EAF6EC" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>2. 연구 처리</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>v1 순환판</B><BR ALIGN="LEFT"/>dense caption + VQA 답변 template<BR ALIGN="LEFT"/>documents 7,000 / queries 244<BR ALIGN="LEFT"/>filter·qrels·문서가 VQA 계보 공유</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>① 20260710_noncircular 수리</B><BR ALIGN="LEFT"/>VQA-derived 문서 제거<BR ALIGN="LEFT"/>document=외부 dense caption<BR ALIGN="LEFT"/>relevance=accident_type<BR ALIGN="LEFT"/>filter=weather_light/road_type/location</FONT></TD></TR></TABLE>>];
  stored [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="360" BGCOLOR="#F5F7FA" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>3. 현재 디스크/DB 산출물</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>canonical/</B><BR ALIGN="LEFT"/>clips.parquet 1,000 / documents.parquet 1,000<BR ALIGN="LEFT"/>metadata.parquet 6,000 rows<BR ALIGN="LEFT"/>queries.jsonl 85<BR ALIGN="LEFT"/>qrels.tsv 3,744 / semantic 9,703</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>문서 행의 값</B><BR ALIGN="LEFT"/>text=날씨·도로·주행·사고를 설명하는 영어 문장<BR ALIGN="LEFT"/>source=외부 caption parquet 파일명</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>embeddings/bge-m3/</B><BR ALIGN="LEFT"/>document 1,000 x 1,024<BR ALIGN="LEFT"/>query 85 x 1,024 (NPY + index parquet)</FONT></TD></TR></TABLE>>];
  use [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="330" BGCOLOR="#FFF3D6" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>4. 논문에서 실제 사용</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>검색 대조</B><BR ALIGN="LEFT"/>순환 워크로드 붕괴와 수리 전후 비교<BR ALIGN="LEFT"/>A9 감사·채널 결합도 보고</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>답변</B><BR ALIGN="LEFT"/>고정 LLM 증거 사다리의 앵커 데이터</FONT></TD></TR></TABLE>>];
  raw -> transform [xlabel="입력"];
  transform -> stored [xlabel="materialize"];
  stored -> use [xlabel="평가 입력"];
  { rank=same; raw; transform; }
  { rank=same; stored; use; }
  raw -> stored [style=invis, weight=40];
  transform -> use [style=invis, weight=40];
  warning [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#C63C36" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="520" BGCOLOR="#FFF1F0" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>해석 시 주의</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>논문 표기 원칙</B><BR ALIGN="LEFT"/>수리판도 문서·filter·relevance가 같은 외부 VQA 생산자 계보에 속한다.<BR ALIGN="LEFT"/>따라서 522의 생산자 수준 tri-source와 동등하다고 주장하지 않는다.</FONT></TD></TR></TABLE>>];
  stored -> warning [style=dashed, arrowhead=none, color="#C63C36", constraint=false];
  legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#A7B3C0" CELLSPACING="0" CELLPADDING="6">
      <TR>
        <TD BGCOLOR="#E8F3FA">외부 원본/원 배포</TD>
        <TD BGCOLOR="#EAF6EC">① 추출·파싱·임베딩</TD>
        <TD BGCOLOR="#FFF1C7">② 본 연구 AI 생성</TD>
        <TD BGCOLOR="#FFE5D6">③ 합성·proxy</TD>
        <TD BGCOLOR="#F5F7FA">현재 저장 파일/DB</TD>
        <TD BGCOLOR="#FFF3D6">논문 실험 입력</TD>
      </TR>
    </TABLE>>];
  use -> warning [style=invis, weight=30];
  warning -> legend [style=invis, weight=30];
  }
