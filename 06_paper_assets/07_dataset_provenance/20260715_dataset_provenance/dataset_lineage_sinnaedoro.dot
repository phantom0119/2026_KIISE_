digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.32",
         ranksep="0.68", splines=polyline, outputorder=edgesfirst,
         fontname="NanumBarunGothic", fontsize=20, label="AI Hub 시내도로 CCTV: 실제 프레임 벡터와 합성 1M의 분리
외부 320G -&gt; processed 2.5G | 검색 문서/캡션이 없는 색인 전용 코퍼스",
         labelloc=t, labeljust=l];
  node [fontname="NanumBarunGothic", color="#526476"];
  edge [fontname="NanumBarunGothic", fontsize=9, color="#526476",
        penwidth=1.15, arrowsize=0.72];

  raw [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="330" BGCOLOR="#E8F3FA" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>1. 외부 원본 파일</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>배포 형식</B><BR ALIGN="LEFT"/>Training/Validation JPG ZIP<BR ALIGN="LEFT"/>고정형 도로 CCTV 프레임 (MP4 아님)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>프레임 식별 정보</B><BR ALIGN="LEFT"/>location / camera / date / time<BR ALIGN="LEFT"/>예: 범박터널-범박1교방향, BC1000501, 20201004</FONT></TD></TR></TABLE>>];
  transform [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="330" BGCOLOR="#EAF6EC" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>2. 연구 처리</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>① 실제 데이터 변환</B><BR ALIGN="LEFT"/>원천 JPG ZIP 131개를 풀지 않고 직접 읽기<BR ALIGN="LEFT"/>위치·카메라·시간에 걸쳐 분산 표집<BR ALIGN="LEFT"/>CLIP ViT-B/32 -&gt; 512차원, L2 정규화<BR ALIGN="LEFT"/>표집 JPG 자체는 별도 파일로 저장하지 않음</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>③ 합성 규모 확장</B><BR ALIGN="LEFT"/>real vector 재표본 + jitter로 기록<BR ALIGN="LEFT"/>1,000,000개 CLIP-space vector 생성</FONT></TD></TR></TABLE>>];
  stored [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="360" BGCOLOR="#F5F7FA" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>3. 현재 디스크/DB 산출물</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>corpus_real/</B><BR ALIGN="LEFT"/>frame_embeddings.npy: 132,521 x 512 float32 (~259MiB)<BR ALIGN="LEFT"/>frame_index.parquet: 132,521 rows<BR ALIGN="LEFT"/>facets: location 39 / camera 16,107 / date 51<BR ALIGN="LEFT"/>queries.npy: hold-out 1,000 x 512</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>corpus_aug_1m.npy</B><BR ALIGN="LEFT"/>1,000,000 x 512 float32<BR ALIGN="LEFT"/>2,048,000,128 bytes (약 1.91GiB)<BR ALIGN="LEFT"/>실제 JPG 100만 장이 아니라 합성 벡터</FONT></TD></TR></TABLE>>];
  use [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#526476" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="330" BGCOLOR="#FFF3D6" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>4. 논문에서 실제 사용</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>real 132,521</B><BR ALIGN="LEFT"/>실제 시공간 predicate filtered-ANN<BR ALIGN="LEFT"/>FAISS 색인 Pareto<BR ALIGN="LEFT"/>PostgreSQL b3_frames 부분색인</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>synthetic 1M</B><BR ALIGN="LEFT"/>메모리·지연시간 규모 확장만 측정<BR ALIGN="LEFT"/>실제 CCTV 분포/라벨 성능 주장에 사용하지 않음</FONT></TD></TR></TABLE>>];
  raw -> transform [xlabel="입력"];
  transform -> stored [xlabel="materialize"];
  stored -> use [xlabel="평가 입력"];
  { rank=same; raw; transform; }
  { rank=same; stored; use; }
  raw -> stored [style=invis, weight=40];
  transform -> use [style=invis, weight=40];
  warning [shape=plain, margin=0, label=<<TABLE BORDER="1" COLOR="#C63C36" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="520" BGCOLOR="#FFF1F0" ALIGN="LEFT" CELLPADDING="9"><FONT POINT-SIZE="16"><B>해석 시 주의</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="8"><FONT POINT-SIZE="11"><B>논문 표기 원칙</B><BR ALIGN="LEFT"/>real과 synthetic 결과를 표·파일명에서 분리한다.<BR ALIGN="LEFT"/>1M 생성 seed/jitter/source map manifest가 없어 원점 재현 계보는 현재 불완전하다.</FONT></TD></TR></TABLE>>];
  stored -> warning [style=dashed, arrowhead=none, color="#C63C36", constraint=false];
  legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#A7B3C0" CELLSPACING="0" CELLPADDING="6">
      <TR>
        <TD BGCOLOR="#E8F3FA">외부 원본/원 배포</TD>
        <TD BGCOLOR="#EAF6EC">① 추출·파싱·임베딩</TD>
        <TD BGCOLOR="#FFF1C7">② 본 연구 AI 생성</TD>
        <TD BGCOLOR="#FFE5D6">③ 합성·proxy</TD>
        <TD BGCOLOR="#F5F7FA">현재 저장 파일/DB</TD>
        <TD BGCOLOR="#FFF3D6">논문 실험 입력</TD>
      </TR>
    </TABLE>>];
  use -> warning [style=invis, weight=30];
  warning -> legend [style=invis, weight=30];
  }
